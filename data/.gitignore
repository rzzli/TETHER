# Keep originals, reference payloads, generated outputs, evaluation records and caches out of version control.
/raw/**
!/raw/**/
!/raw/**/.gitkeep
/reference/**
!/reference/**/
!/reference/**/.gitkeep
/derived/**
!/derived/**/
!/derived/**/.gitkeep
/benchmark/**
!/benchmark/**/
!/benchmark/**/.gitkeep
/cache/**
!/cache/**/
!/cache/**/.gitkeep

# Historical manifests remain local and in the tagged checkpoint.
/manifests/**
!/manifests/.gitkeep
!/manifests/README.md
/catalog/history/

# Never track local credentials, signed-link files or editor/runtime residue.
**/.env
**/.env.*
**/*credentials*
**/*secrets*
**/*signed_urls*
**/*.tmp
**/*.partial
**/__pycache__/
**/.DS_Store

# An actual restore clone contains a nested Git repository; do not traverse it.
/cache/remote-recovery-restore-test/

# Checkpoints/restored repositories contain nested ignore files and placeholders.
# Exclude their roots so nested rules cannot reintroduce archived payloads.
/reference/recovery-checkpoint-*/
/reference/recovery-restored-*/
/cache/recovery-restore-*/
/cache/tether-namespace-migration-20261106/
/cache/original-reproduction/
