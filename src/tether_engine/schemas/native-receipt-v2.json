{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tether:native-receipt:v2",
  "title": "Current TETHER native receipt v2 producer shape",
  "description": "Shape only: exact-byte hashes, sequence token types, source roles/closure/eligibility, state reconciliation and external authority need separate verification. Legacy receipts require their explicit compatibility policy.",
  "type": "object",
  "required": [
    "schema_version",
    "software_version",
    "admission_policy",
    "input_fingerprint",
    "outputs",
    "sources",
    "admitted_fingerprints",
    "code"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "software_version": {
      "const": "0.6.0.dev1"
    },
    "admission_policy": {
      "const": "tether.derivation.v1"
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "outputs": {
      "type": "object",
      "required": [
        "run.json",
        "inputs.json",
        "ledger.json",
        "features.json",
        "prediction.json",
        "trace.jsonl",
        "journal.jsonl",
        "dossier.md"
      ],
      "properties": {
        "run.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inputs.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ledger.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "features.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prediction.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "trace.jsonl": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "journal.jsonl": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dossier.md": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "auxiliary_outputs": {
      "type": "object",
      "properties": {
        "request.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "backend-execution.json": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "dataset_id",
          "release_id",
          "path",
          "sha256"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "dataset_id": {
            "type": "string",
            "minLength": 1
          },
          "release_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "enum": [
              "agent_evidence",
              "reference"
            ]
          },
          "parents": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "receipt_path": {
            "type": "string",
            "minLength": 1
          },
          "receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "dependentRequired": {
          "role": [
            "parents"
          ],
          "parents": [
            "role"
          ],
          "receipt_path": [
            "receipt_sha256"
          ],
          "receipt_sha256": [
            "receipt_path"
          ]
        },
        "additionalProperties": false
      }
    },
    "admitted_fingerprints": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "additionalProperties": false
}
