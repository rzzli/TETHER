{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Active v2 documentation of the implemented diagnostic._flat post-validator. Additional Python checks enforce nonblank strings, source/pointer resolution and pair lengths, unique claims, source-report literal fidelity, inference/caution limitations, and answer states. Per-request maxItems is the request claim bound (at most three). The generic native object grammar does not enforce this contract. Retained v1 is the original R05 planning reference.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "answer_status",
    "claims",
    "unresolved",
    "abstention_reason"
  ],
  "properties": {
    "answer_status": {
      "enum": [
        "answered",
        "partial",
        "abstained"
      ]
    },
    "abstention_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 512
    },
    "unresolved": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1800
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "text",
          "source_ids",
          "quote_pointers",
          "limitations"
        ],
        "properties": {
          "kind": {
            "enum": [
              "source_report",
              "scientific_inference",
              "caution"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1800
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "string",
              "pattern": "^E[0-9]+$"
            }
          },
          "quote_pointers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "limitations": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1800
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "answer_status": {
            "const": "abstained"
          }
        }
      },
      "then": {
        "properties": {
          "claims": {
            "maxItems": 0
          },
          "abstention_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "answer_status": {
            "const": "partial"
          }
        }
      },
      "then": {
        "properties": {
          "claims": {
            "minItems": 1
          },
          "abstention_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "answer_status": {
            "const": "answered"
          }
        }
      },
      "then": {
        "properties": {
          "claims": {
            "minItems": 1
          },
          "abstention_reason": {
            "type": "null"
          }
        }
      }
    }
  ]
}
